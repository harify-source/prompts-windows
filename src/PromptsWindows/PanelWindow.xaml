<Window x:Class="PromptsWindows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Prompts"
        Width="960"
        Height="680"
        MinWidth="320"
        MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFFDF8"
        Deactivated="OnDeactivated">
  <Border BorderBrush="#33000000" BorderThickness="1">
    <Grid>
      <wv2:WebView2 x:Name="WebView" />
      <Border x:Name="OfflinePanel"
              Background="#FFFDF8"
              Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
          <TextBlock Text="Can't reach Prompts."
                     FontSize="16"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,8" />
          <TextBlock x:Name="OfflineDetail"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="#666666"
                     Margin="0,0,0,12" />
          <Button Content="Retry"
                  Width="88"
                  Height="28"
                  HorizontalAlignment="Center"
                  Click="OnRetryClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
